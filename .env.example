# ============================================================
#  AloqaPro Server Konfiguratsiyasi
# ============================================================

# Server porti va tarmog'i
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Serverdagi PostgreSQL ma'lumotlar bazasi (Ubuntu lokal yoki Docker)
# Ubuntu native: postgres://aloqa_user:aloqa_password@localhost:5432/aloqapro
# Docker Compose: avtomatik db servisi ulanadi
DATABASE_URL=postgres://aloqa_user:aloqa_password@localhost:5432/aloqapro
DB_NAME=aloqapro
DB_USER=aloqa_user
DB_PASSWORD=aloqa_password

# Supabase sozlamalari
SUPABASE_URL=https://hdbhdddekjjjtwtyocfa.supabase.co
SUPABASE_ANON_KEY=sb_publishable_CZUB0mOSzmmCvviNzWykzw_B3_0-5bE
# Xodimlarni yaratish va parolini yangilash uchun Supabase service_role kaliti:
SUPABASE_SERVICE_ROLE_KEY=
# Backend API bazaviy marshruti (server.js dagi ichki API)
FUNCTIONS_BASE=/api/functions/v1


# Google Sheets integratsiyasi (TO'XTATILGAN / FALSE)
ENABLE_GOOGLE_SHEETS=false

# Ma'lumotlarni tozalash siyosati (Data Retention)
# Har 2 oyda 3 oydan eski yozuvlar avtomatik o'chiriladi
RETENTION_MONTHS=3
RETENTION_INTERVAL_MONTHS=2
CLEANUP_ADMIN_KEY=aloqa_cleanup_secret_key_2026
