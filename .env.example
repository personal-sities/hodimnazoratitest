# ============================================================
#  AloqaPro Server Konfiguratsiyasi
# ============================================================

# Server porti
PORT=3000
NODE_ENV=production

# Serverdagi PostgreSQL ma'lumotlar bazasi (Ubuntu lokal)
DATABASE_URL=postgres://aloqa_user:aloqa_password@localhost:5432/aloqapro

# Supabase ulanish sozlamalari (Serverdagi Docker yoki Cloud)
SUPABASE_URL=https://hdbhdddekjjjtwtyocfa.supabase.co
SUPABASE_ANON_KEY=sb_publishable_CZUB0mOSzmmCvviNzWykzw_B3_0-5bE
SUPABASE_SERVICE_ROLE_KEY=
FUNCTIONS_BASE=https://hdbhdddekjjjtwtyocfa.supabase.co/functions/v1

# amoCRM Integratsiyasi (kerak bo'lsa true, bo'lmasa false qiling)
ENABLE_AMOCRM=false
AMOCRM_SUBDOMAIN=isft07
AMOCRM_ACCESS_TOKEN=

# OnlinePBX Integratsiyasi (kerak bo'lsa true, bo'lmasa false qiling)
ENABLE_ONLINEPBX=false
ONLINEPBX_API_KEY=
ONLINEPBX_DOMAIN=

# Google Sheets integratsiyasi (TO'XTATILGAN / FALSE)
ENABLE_GOOGLE_SHEETS=false

# Ma'lumotlarni tozalash siyosati (Data Retention)
# Har 2 oyda 3 oydan eski yozuvlar avtomatik o'chiriladi
RETENTION_MONTHS=3
RETENTION_INTERVAL_MONTHS=2
CLEANUP_CRON=0 3 1 */2 *
CLEANUP_ADMIN_KEY=aloqa_cleanup_secret_key_2026
