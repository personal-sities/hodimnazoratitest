# ============================================================
#  AloqaPro Server Konfiguratsiyasi (100% PostgreSQL & Server)
# ============================================================

# Server porti va tarmog'i
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Serverdagi PostgreSQL ma'lumotlar bazasi (Ubuntu lokal yoki Docker)
# Standart: postgres://aloqa_user:aloqa_password@localhost:5432/aloqapro
DATABASE_URL=postgres://aloqa_user:aloqa_password@localhost:5432/aloqapro
DB_NAME=aloqapro
DB_USER=aloqa_user
DB_PASSWORD=aloqa_password

# Ichki Backend API bazaviy marshruti
FUNCTIONS_BASE=/api/functions/v1

# Google Sheets integratsiyasi (TO'XTATILGAN / FALSE)
ENABLE_GOOGLE_SHEETS=false

# Ma'lumotlarni tozalash siyosati (Data Retention)
# Har 2 oyda 3 oydan eski yozuvlar avtomatik o'chiriladi
RETENTION_MONTHS=3
RETENTION_INTERVAL_MONTHS=2
CLEANUP_ADMIN_KEY=aloqa_cleanup_secret_key_2026
